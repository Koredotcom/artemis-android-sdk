<resources>
    <style name="Theme.ArtemisUI.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#2563EB</item>
        <item name="android:navigationBarColor">@color/artemis_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.ArtemisUI" parent="Theme.ArtemisUI.Base" />
    <style name="Widget.ArtemisUI.AttachmentAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/artemis_primary</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
</resources>
