<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/artemis_background"
    android:orientation="vertical">

    <include layout="@layout/artemis_chat_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/artemis_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp" />

        <include layout="@layout/artemis_chat_empty" />
    </FrameLayout>

    <TextView
        android:id="@+id/artemis_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:accessibilityLiveRegion="polite"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/artemis_typing"
        android:textColor="@color/artemis_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/artemis_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/artemis_retry"
        android:visibility="gone" />

    <TextView
        android:id="@+id/artemis_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="12dp"
        android:textColor="@color/artemis_text"
        android:visibility="gone" />

    <include layout="@layout/artemis_chat_composer" />
</LinearLayout>
