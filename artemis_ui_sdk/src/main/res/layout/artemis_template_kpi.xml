<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <ImageView android:id="@+id/artemis_kpi_icon" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_marginBottom="6dp" android:scaleType="centerCrop" android:visibility="gone" />
    <TextView android:id="@+id/artemis_kpi_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.02" android:textColor="@color/artemis_muted" />
    <TextView android:id="@+id/artemis_kpi_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/artemis_text" />
    <TextView android:id="@+id/artemis_kpi_trend" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/artemis_muted" />
</LinearLayout>
