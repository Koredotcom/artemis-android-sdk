<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artemis_header" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@color/artemis_primary">
    <TextView android:id="@+id/artemis_avatar" android:layout_width="@dimen/artemis_avatar_size" android:layout_height="@dimen/artemis_avatar_size"
        android:gravity="center" android:text="A" android:textSize="14sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="@drawable/artemis_avatar_background" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/artemis_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/artemis_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="#DBEAFE" android:maxLines="1"
            android:ellipsize="end" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <ImageButton android:id="@+id/artemis_minimize" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/artemis_ic_minimize" android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/artemis_icon_button_padding" android:scaleType="centerInside" android:contentDescription="@string/artemis_minimize" />
    <ImageButton android:id="@+id/artemis_close" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/artemis_ic_close" android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/artemis_icon_button_padding" android:scaleType="centerInside" android:contentDescription="@string/artemis_close" />
</LinearLayout>
