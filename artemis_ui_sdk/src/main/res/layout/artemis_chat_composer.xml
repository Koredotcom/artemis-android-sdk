<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artemis_composer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artemis_background"
    android:orientation="vertical">

    <!-- Kept for host code that styles it; the Web-aligned composer has no divider. -->
    <View
        android:id="@+id/artemis_composer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artemis_border"
        android:visibility="gone" />

    <!-- Web parity: a 14dp margin around one bordered pill holding attach, input and send. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/artemis_composer_margin"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/artemis_composer_margin"
        android:paddingBottom="@dimen/artemis_composer_margin">

        <LinearLayout
            android:id="@+id/artemis_attachment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/artemis_attachment_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/artemis_muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/artemis_attachment_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/artemis_composer_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/artemis_composer_bar_background"
            android:gravity="center_vertical"
            android:minHeight="@dimen/artemis_composer_bar_min_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/artemis_composer_bar_padding_start"
            android:paddingTop="@dimen/artemis_composer_bar_padding_vertical"
            android:paddingEnd="@dimen/artemis_composer_bar_padding_end"
            android:paddingBottom="@dimen/artemis_composer_bar_padding_vertical">

            <ImageButton
                android:id="@+id/artemis_attach"
                android:layout_width="@dimen/artemis_composer_action_size"
                android:layout_height="@dimen/artemis_composer_action_size"
                android:layout_marginEnd="4dp"
                android:background="@drawable/artemis_composer_icon_ripple"
                android:contentDescription="@string/artemis_attach_file"
                android:padding="@dimen/artemis_composer_attach_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/artemis_ic_attach"
                android:visibility="gone" />

            <EditText
                android:id="@+id/artemis_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/artemis_hint"
                android:imeOptions="actionSend"
                android:includeFontPadding="false"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="@dimen/artemis_composer_action_size"
                android:minLines="1"
                android:paddingStart="5dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/artemis_text"
                android:textColorHint="@color/artemis_muted"
                android:textSize="@dimen/artemis_composer_text_size" />

            <ImageButton
                android:id="@+id/artemis_send"
                android:layout_width="@dimen/artemis_composer_action_size"
                android:layout_height="@dimen/artemis_composer_action_size"
                android:layout_marginStart="4dp"
                android:background="@drawable/artemis_send_background"
                android:contentDescription="@string/artemis_send"
                android:padding="@dimen/artemis_composer_send_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/artemis_ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
