<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artemis_composer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artemis_background"
    android:orientation="vertical">

    <View
        android:id="@+id/artemis_composer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artemis_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:id="@+id/artemis_attachment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/artemis_attachment_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/artemis_muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/artemis_attachment_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/artemis_attach"
                android:layout_width="@dimen/artemis_composer_action_size"
                android:layout_height="@dimen/artemis_composer_action_size"
                android:layout_marginEnd="8dp"
                android:background="@drawable/artemis_control_background"
                android:contentDescription="@string/artemis_attach_file"
                android:padding="@dimen/artemis_composer_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/artemis_ic_attach"
                android:visibility="gone" />

            <EditText
                android:id="@+id/artemis_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/artemis_composer_background"
                android:gravity="center_vertical"
                android:hint="@string/artemis_hint"
                android:imeOptions="actionSend"
                android:includeFontPadding="false"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="@dimen/artemis_composer_action_size"
                android:minLines="1"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:textColor="@color/artemis_text"
                android:textColorHint="@color/artemis_muted"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/artemis_send"
                android:layout_width="@dimen/artemis_composer_action_size"
                android:layout_height="@dimen/artemis_composer_action_size"
                android:layout_marginStart="8dp"
                android:background="@drawable/artemis_send_background"
                android:contentDescription="@string/artemis_send"
                android:padding="@dimen/artemis_composer_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/artemis_ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
