<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="8dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="18dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/artemis_composer_background">
        <EditText android:id="@+id/artemis_input" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:background="@null" android:padding="0dp"
            android:hint="@string/artemis_hint" android:textSize="14sp" android:textColor="@color/artemis_text"
            android:textColorHint="@color/artemis_muted" android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend" android:minLines="1" android:maxLines="5" />
        <ImageButton android:id="@+id/artemis_send" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="14dp" android:layout_marginStart="4dp" android:src="@drawable/artemis_ic_send"
            android:background="@drawable/artemis_send_background" android:contentDescription="@string/artemis_send" />
    </LinearLayout>
</LinearLayout>
