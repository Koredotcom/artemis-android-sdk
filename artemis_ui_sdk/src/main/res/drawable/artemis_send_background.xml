<?xml version="1.0" encoding="utf-8"?>
<!-- Web parity: a 30dp filled circle drawn inside the 40dp touch target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <inset android:inset="@dimen/artemis_composer_send_inset">
            <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
        </inset>
    </item>
    <item>
        <inset android:inset="@dimen/artemis_composer_send_inset">
            <shape android:shape="oval"><solid android:color="@color/artemis_primary" /></shape>
        </inset>
    </item>
</ripple>
